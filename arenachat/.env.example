ARENACHAT_API_KEY=sk-arenachat
ARENACHAT_HOST=127.0.0.1
ARENACHAT_PORT=1998
ARENACHAT_ACCOUNT=arena_account.json
ARENACHAT_COOKIE=
ARENACHAT_DEFAULT_MODEL=gpt-4o
ARENACHAT_BASE_URL=https://arena.ai

# Absolute path to this project clone (recommended if you run from any cwd)
# ARENACHAT_HOME=

# Get your Arena AI cookie:
# 1. Open https://arena.ai in your browser and log in
# 2. Open DevTools (F12) → Network tab
# 3. Refresh the page, click on any request to arena.ai
# 4. Find the "Cookie" header in Request Headers
# 5. Copy the entire cookie value and paste it in ARENACHAT_COOKIE
