#!/usr/bin/env bash
# DeepSeekChat launcher — add this scripts/ folder to your PATH.
# Works from any directory. Example:
#   deepseek serve
#   deepseek setup
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export DEEPSEEKCHAT_HOME="${DEEPSEEKCHAT_HOME:-$ROOT}"
cd "$DEEPSEEKCHAT_HOME"

if [[ -x "$DEEPSEEKCHAT_HOME/.venv/bin/python" ]]; then
  exec "$DEEPSEEKCHAT_HOME/.venv/bin/python" -m deepseekchat "$@"
elif command -v python3 >/dev/null 2>&1; then
  exec python3 -m deepseekchat "$@"
elif command -v python >/dev/null 2>&1; then
  exec python -m deepseekchat "$@"
fi

echo "Error: Python not found. Create a venv in the project and install deps:" >&2
echo "  cd \"$DEEPSEEKCHAT_HOME\"" >&2
echo "  python -m venv .venv && source .venv/bin/activate" >&2
echo "  pip install -r requirements.txt && pip install -e ." >&2
exit 1