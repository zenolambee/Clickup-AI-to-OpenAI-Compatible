#!/usr/bin/env bash
# PokeeChat launcher — add this scripts/ folder to your PATH.
# Works from any directory. Example:
#   pokee serve
#   pokee setup
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export POKEECHAT_HOME="${POKEECHAT_HOME:-$ROOT}"
cd "$POKEECHAT_HOME"

if [[ -x "$POKEECHAT_HOME/.venv/bin/python" ]]; then
  exec "$POKEECHAT_HOME/.venv/bin/python" -m pokeechat "$@"
elif command -v python3 >/dev/null 2>&1; then
  exec python3 -m pokeechat "$@"
elif command -v python >/dev/null 2>&1; then
  exec python -m pokeechat "$@"
fi

echo "Error: Python not found. Create a venv in the project and install deps:" >&2
echo "  cd \"$POKEECHAT_HOME\"" >&2
echo "  python -m venv .venv && source .venv/bin/activate" >&2
echo "  pip install -r requirements.txt && pip install -e ." >&2
exit 1