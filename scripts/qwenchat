#!/usr/bin/env bash
# QwenChat launcher — add this scripts/ folder to your PATH.
# Works from any directory. Example:
#   qwenchat serve
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export QWENCHAT_HOME="${QWENCHAT_HOME:-$ROOT}"
cd "$QWENCHAT_HOME"

if [[ -x "$QWENCHAT_HOME/.venv/bin/python" ]]; then
  exec "$QWENCHAT_HOME/.venv/bin/python" -m qwenchat "$@"
elif command -v python3 >/dev/null 2>&1; then
  exec python3 -m qwenchat "$@"
elif command -v python >/dev/null 2>&1; then
  exec python -m qwenchat "$@"
fi

echo "Error: Python not found. Create a venv in the project and install deps:" >&2
echo "  cd \"$QWENCHAT_HOME\"" >&2
echo "  python -m venv .venv && source .venv/bin/activate" >&2
echo "  pip install -r requirements.txt && pip install -e ." >&2
exit 1
