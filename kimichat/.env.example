KIMICHAT_API_KEY=sk-kimichat
KIMICHAT_HOST=127.0.0.1
KIMICHAT_PORT=1997
KIMICHAT_ACCOUNT=kimi_account.json
KIMICHAT_DEFAULT_MODEL=kimi
KIMICHAT_BASE_URL=https://www.kimi.com

# --- Cookie / token auth ---
# Kimi uses a refresh_token (long-lived) that is exchanged for a short-lived
# access_token automatically. You normally only need KIMICHAT_REFRESH_TOKEN.
#
# How to get it:
#   1. Open https://www.kimi.com in your browser and log in.
#   2. DevTools (F12) -> Application -> Local Storage -> https://www.kimi.com
#   3. Copy the value of the key "refresh_token" (starts with "eyJ...").
KIMICHAT_REFRESH_TOKEN=

# Optional: paste an already-minted access_token to skip the first refresh.
# KIMICHAT_ACCESS_TOKEN=

# Optional: full document.cookie string (helps if Kimi enforces device checks).
# KIMICHAT_COOKIES=

# Optional: stable device id for fingerprint headers (auto-generated if empty).
# KIMICHAT_DEVICE_ID=

# Optional: absolute path to this project clone so `.env` is found from any cwd.
# KIMICHAT_HOME=
