HIGGSFIELDCHAT_API_KEY=sk-higgsfieldchat
HIGGSFIELDCHAT_HOST=127.0.0.1
HIGGSFIELDCHAT_PORT=1992
HIGGSFIELDCHAT_ACCOUNT=higgsfield_account.json
HIGGSFIELDCHAT_BASE_URL=https://higgsfield.ai
HIGGSFIELDCHAT_SC_BASE_URL=https://higgsfield.ai
HIGGSFIELDCHAT_DEFAULT_MODEL=supercomputer

# Cookie dari browser setelah login di https://higgsfield.ai
# Buka DevTools (F12) -> Application -> Cookies -> https://www.higgsfield.ai
# Copy value dari cookie "__session"
# HIGGSFIELD_COOKIE=__session=...

# Atau paste full document.cookie:
# HIGGSFIELD_COOKIE=__session=...; hf-first-visit-at=...; ...