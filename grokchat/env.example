GROKCHAT_API_KEY=sk-grokchat
GROKCHAT_HOST=127.0.0.1
GROKCHAT_PORT=1996
GROKCHAT_ACCOUNT=grok_account.json
GROKCHAT_DEFAULT_MODEL=grok-3

# --- Cookie Auth (isi salah satu cara di bawah) ---

# Cara 1: Isi masing-masing cookie (paling mudah)
# Buka DevTools (F12) -> Application -> Cookies -> https://grok.com
# Copy value dari kolom "Value" masing-masing cookie:
GROKCHAT_SSO=
GROKCHAT_SSO_RW=
GROKCHAT_X_USERID=

# Cara 2: Full cookie string (Copy All)
# Klik kanan header tabel cookies -> Copy All, lalu paste di sini:
# GROKCHAT_COOKIES=
