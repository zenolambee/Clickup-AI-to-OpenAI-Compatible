# Absolute path to this project clone (recommended if you run from any cwd)
# QWENCHAT_HOME=

# Get your Qwen token:
# 1. Open https://chat.qwen.ai in your browser
# 2. Open DevTools (F12) → Application → Local Storage → https://chat.qwen.ai
# 3. Copy the value of the "token" key
# 4. Paste it in QWENCHAT_TOKEN
# ===== PokeeChat (pokee.ai) =====
POKEECHAT_API_KEY=sk-pokeechat
POKEECHAT_HOST=127.0.0.1
POKEECHAT_PORT=1993
POKEECHAT_BASE_URL=https://api.pokee.ai/v1
POKEECHAT_DEFAULT_MODEL=pokee-isaac
# Get your Pokee API key:
# 1. Open https://console.pokee.ai/keys and sign in
# 2. Create a key (shown only once, starts with "pk-")
# 3. Paste it in POKEE_API_KEY
POKEE_API_KEY=pk-your-key-here

# ===== DeepSeekChat (deepseek.com) =====
DEEPSEEKCHAT_API_KEY=sk-deepseekchat
DEEPSEEKCHAT_HOST=127.0.0.1
DEEPSEEKCHAT_PORT=1996
DEEPSEEKCHAT_BASE_URL=https://api.deepseek.com
DEEPSEEKCHAT_DEFAULT_MODEL=deepseek-v4-flash
# Get your DeepSeek API key (5M free tokens on signup):
# 1. Sign up at https://platform.deepseek.com
# 2. Open API Keys and create a key (starts with "sk-")
# 3. Paste it in DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ===== DeepSeekWeb (chat.deepseek.com, cookie auth, no balance needed) =====
DEEPSEEKWEB_API_KEY=sk-deepseekweb
DEEPSEEKWEB_HOST=127.0.0.1
DEEPSEEKWEB_PORT=1997
DEEPSEEKWEB_ACCOUNT=deepseek_account.json
DEEPSEEKWEB_BASE_URL=https://chat.deepseek.com/api/v0
DEEPSEEKWEB_DEFAULT_MODEL=deepseek-v4-flash
# Get your Chat.deepseek.com userToken (no AI balance required):
# 1. Log in at https://chat.deepseek.com
# 2. DevTools (F12) → Application → Local Storage → https://chat.deepseek.com
# 3. Copy the "userToken" value into DEEPSEEKWEB_TOKEN
DEEPSEEKWEB_TOKEN=
